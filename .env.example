# Porta pública local do Nginx
APP_PORT=8080

# Aplicação
APP_ENV=development
APP_NAME=Geo Core API
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO
VITE_API_BASE_URL=/api

# Gateway HTTP — ajuste a CSP ao trocar basemap ou adicionar serviços externos
NGINX_API_RATE=10r/s
NGINX_API_BURST=20
NGINX_API_CONNECTIONS=20
NGINX_CLIENT_MAX_BODY_SIZE=16k
NGINX_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://a.basemaps.cartocdn.com; connect-src 'self' ws: wss:; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# PostGIS — troque a senha em qualquer ambiente compartilhado
# A imagem oficial atual é AMD64; Docker Desktop usa emulação em Apple Silicon.
POSTGIS_PLATFORM=linux/amd64
POSTGRES_DB=geo_core
POSTGRES_USER=geo_core
POSTGRES_PASSWORD=geo_core_local
POSTGRES_APP_USER=geo_core_app
POSTGRES_APP_PASSWORD=geo_core_app_local
