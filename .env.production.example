# Copie para .env.production e substitua todos os valores change-me.
# Use apenas caracteres URL-safe nas senhas (letras, números, -, _, . e ~),
# pois elas compõem URLs de conexão dentro do Compose.

# Publicação local do gateway. Mantenha 127.0.0.1 quando houver um proxy HTTPS
# no host; use 0.0.0.0 apenas quando a porta puder ser exposta diretamente.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_ORIGIN=https://gis.example.com
APP_NAME=Geo Core API
LOG_LEVEL=INFO
VITE_API_BASE_URL=/api
GEO_CORE_IMAGE_TAG=local

# Gateway HTTP — CSP de produção sem scripts inline e sem WebSocket do Vite.
NGINX_API_RATE=10r/s
NGINX_API_BURST=20
NGINX_API_CONNECTIONS=20
NGINX_CLIENT_MAX_BODY_SIZE=16k
NGINX_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://a.basemaps.cartocdn.com; connect-src 'self'; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# PostGIS. Gere valores exclusivos para o ambiente antes do primeiro start.
POSTGIS_PLATFORM=linux/amd64
POSTGRES_DB=geo_core
POSTGRES_USER=geo_core
POSTGRES_PASSWORD=change-me-admin-password
POSTGRES_APP_USER=geo_core_app
POSTGRES_APP_PASSWORD=change-me-runtime-password
